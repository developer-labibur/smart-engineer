<?xml version="1.0" encoding="utf-8"?>
<resources>


    <!-- Light Theme -->
    <style name="AppTheme.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize light theme colors -->
        <item name="pdfBackgroundPrimary">@color/pdf_light</item>
        <item name="pdfBackgroundSecoundary">@color/pdf_s_light</item>
        <item name="pdfIcon">@color/pdf_ic_light</item>
        <item name="pdfText">@color/pdf_text_light</item>

        <item name="pdfIconLibrary">@drawable/sl_library</item>
        <item name="pdfIconCross">@drawable/sl_cross</item>
        <item name="pdfIconBack">@drawable/sl_left_arrow_back</item>
        <item name="pdfSeekBarBG">@drawable/pdf_seekbar_bg_light</item>
        <item name="pdfSeekBarIcon">@drawable/pdf_seekbar_icon_light</item>
        <item name="pdfIconTheme">@drawable/pdf_sun</item>
        <item name="pdfIconRotate">@drawable/sl_smartphone_rotate_orientation</item>
        <item name="pdfIconVertical">@drawable/pdf_slider_horizontal</item>
        <item name="pdfIconHorizontal">@drawable/pdf_slider_vertical</item>
        <item name="pdfIconSwipeHorizontal">@drawable/pdf_posts_carousel_horizontal</item>
        <item name="pdfIconSwipeVertical">@drawable/pdf_posts_carousel_vertical</item>
        <item name="pdfIconSetting">@drawable/sl_settings_fill</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item> <!-- White text on dark theme -->

    </style>

    <!-- Dark Theme -->
    <style name="AppTheme.Dark" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize dark theme colors -->
        <item name="pdfBackgroundPrimary">@color/pdf_dark</item>
        <item name="pdfBackgroundSecoundary">@color/pdf_s_dark</item>
        <item name="pdfIcon">@color/pdf_ic_light</item>
        <item name="pdfText">@color/pdf_text_dark</item>

        <item name="pdfIconLibrary">@drawable/pdf_library</item>
        <item name="pdfIconCross">@drawable/pdf_cross</item>
        <item name="pdfIconBack">@drawable/pdf_left_arrow_back</item>
        <item name="pdfSeekBarBG">@drawable/pdf_seekbar_bg_dark</item>
        <item name="pdfSeekBarIcon">@drawable/pdf_seekbar_icon_dark</item>
        <item name="pdfIconTheme">@drawable/pdf_moon</item>
        <item name="pdfIconRotate">@drawable/pdf_smartphone_rotate_orientation</item>
        <item name="pdfIconVertical">@drawable/pdf_slider_horizontal_light</item>
        <item name="pdfIconHorizontal">@drawable/pdf_slider_vertical_light</item>
        <item name="pdfIconSwipeHorizontal">@drawable/pdf_posts_carousel_horizontal_light</item>
        <item name="pdfIconSwipeVertical">@drawable/pdf_posts_carousel_vertical_light</item>
        <item name="pdfIconSetting">@drawable/pdf_setting</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item> <!-- Dark text on light theme -->

    </style>




    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>




    <style name="CustomAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_notice_item</item>
    </style>

    <style name="sl_header_button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:contentDescription">@string/sl_icon</item>
        <item name="android:padding">7dp</item>
    </style>

    <style name="sl_sidebar_icon">
        <item name="android:layout_marginBottom">@dimen/size_sidebar_margin</item>
        <item name="android:background">@drawable/sl_circle_bg</item>
        <item name="android:contextClickable">true</item>
        <item name="android:padding">@dimen/size_sidebar_padding</item>
        <item name="android:layout_height">@dimen/size_sidebar_icon_size</item>
        <item name="android:layout_width">@dimen/size_sidebar_icon_size</item>
    </style>

    <style name="sideBar">
        <item name="android:layout_width">@dimen/size_sidebar_width</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/sideBar_Bg</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="sideBarTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/size_small</item>
        <item name="android:fontFamily">@font/main_font_regular_2</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">@color/mainContainer_SubHeadingText</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ================================================================================================== -->
    <!--                                           HEADING TAG                                              -->
    <!-- ================================================================================================== -->

    <style name="mainContainer_H1">
        <item name="android:fontFamily">@font/main_font_regular_2</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/mainContainer_HeadingText</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="mainContainer_H2">
        <item name="android:layout_marginTop">-15dp</item>
        <item name="android:fontFamily">@font/main_font_regular_2</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/mainContainer_SubHeadingText</item>
        <item name="android:textSize">25sp</item>
    </style>

    <!-- ================================================================================================== -->
    <!--                                           LOGO => LIGHT                                            -->
    <!-- ================================================================================================== -->

    <style name="sideBarLogo">
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:src">@drawable/logo_blue</item>
    </style>

    <style name="dayNightLogo">
        <item name="android:layout_width">37dp</item>
        <item name="android:layout_height">37dp</item>
        <item name="android:elevation">20dp</item>
        <item name="android:src">@drawable/logo_blue</item>
    </style>

    <style name="btn_social_media">
        <item name="android:background">@drawable/sl_button_social_login_signup</item>
        <item name="android:clickable">true</item>
        <item name="android:contentDescription">@string/continue_with_social_media</item>
        <item name="android:elevation">4dp</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">@dimen/size_xlarge</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">34dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="bottom_nav_text_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:visibility">gone</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:textColor">@color/mainContainer_HeadingText</item>
        <item name="android:fontFamily">@font/logo_font</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="bottom_nav_bg">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Rounded" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">40dp</item>
    </style>

    <style name="department_left">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginEnd">50dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">35dp</item>
        <item name="android:paddingEnd">25dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="dep_text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/josefin_sans_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/mainContainer_HeadingText</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="dep_right">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:layout_marginStart">50dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">25dp</item>
        <item name="android:paddingEnd">35dp</item>
    </style>

    <style name="btn_features_layout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="btn_features_image">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="btn_features_text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/main_font_regular_2</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/sl_primary_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="sem_text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginTop">-8dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/main_font_regular_2</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAlignment">textStart</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/sl_primary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="shape_bottom_nav_bar_image">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:padding">3dp</item>
    </style>

    <style name="setting_item_view">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">50dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:background">@color/sl_primary</item>
    </style>

    <style name="setting_item_image_fill">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_setting_item_color</item>
    </style>

    <style name="setting_item_image">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_setting_item</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="setting_item_layout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">50dp</item>
        <item name="android:layout_marginEnd">35dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="setting_item_heading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="setting_item_subheading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">-2dp</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">-5dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="setting_item_image_right">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">0dp</item>
    </style>

    <style name="dashboard_smart_point_text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:fontFamily">@font/main_font_regular_2</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/sl_primary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="radio_button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mainContainer_HeadingText</item>
        <item name="android:textSize">@dimen/_16sp</item>
    </style>

    <style name="tv_center_heading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="android:textColor">@color/mainContainer_HeadingText</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="tv_center_paragraph">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">-3dp</item>
        <item name="android:textColor">@color/mainContainer_HeadingText</item>
        <item name="android:textSize">@dimen/_16sp</item>
    </style>

</resources>