<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    tools:context=".ui.fragments.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="-5dp"
                android:layout_marginEnd="-5dp"
                android:contentDescription="@string/home_page_top_background_image"
                android:scaleType="fitEnd"
                android:src="@drawable/bg_technology_top_red"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Header Section -->

            <LinearLayout
                android:id="@+id/ic_menuBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/circle_shadow_icon"
                android:elevation="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view"
                tools:targetApi="p">

                <ImageView
                    style="@style/dayNightLogo"
                    android:contentDescription="@string/smart_engineer_logo"
                    android:src="@drawable/logo_orange_black" />

            </LinearLayout>

            <view
                android:id="@+id/view"
                class="android.widget.ImageView"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSmart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="-22dp"
                android:elevation="30dp"
                android:fontFamily="@font/logo_font"
                android:letterSpacing="0.0"
                android:text="@string/smart"
                android:textAllCaps="true"
                android:textColor="@color/mainContainer_HeadingText"
                android:textSize="33sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/ic_menuBtn"
                app:layout_constraintTop_toTopOf="@+id/ic_menuBtn" />

            <TextView
                android:id="@+id/tvE"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-34dp"
                android:elevation="30dp"
                android:fontFamily="@font/logo_font"
                android:letterSpacing="0.05"
                android:text="@string/e"
                android:textAllCaps="true"
                android:textColor="@color/mainContainer_HeadingText"
                android:textSize="33sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/tvSmart"
                app:layout_constraintTop_toBottomOf="@+id/tvSmart" />

            <TextView
                android:id="@+id/tvEngineer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:elevation="30dp"
                android:fontFamily="@font/logo_font"
                android:text="@string/ngineer"
                android:textAllCaps="true"
                android:textColor="@color/mainContainer_SubHeadingText"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/tvE"
                app:layout_constraintTop_toTopOf="@+id/tvE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="30dp"
                android:fontFamily="@font/logo_font"
                android:text="@string/ing"
                android:textAllCaps="true"
                android:textColor="@color/mainContainer_SubHeadingText"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/tvEngineer"
                app:layout_constraintTop_toTopOf="@+id/tvEngineer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:elevation="30dp"
                android:fontFamily="@font/logo_font"
                android:text="@string/learning_app"
                android:textAllCaps="true"
                android:textColor="@color/mainContainer_SubHeadingText"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tvE"
                app:layout_constraintStart_toEndOf="@+id/tvE" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="70dp"
                android:contentDescription="@string/rocket"
                android:src="@drawable/rocket"
                app:layout_constraintBottom_toTopOf="@+id/tvSmart"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Polytechnic Section -->
            <LinearLayout
                android:id="@+id/btnProfile"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/rectangle_shadow_icon"
                android:elevation="20dp"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvE">

                <TextView
                    android:id="@+id/tvPoly"
                    android:layout_width="165dp"
                    android:layout_height="wrap_content"
                    android:elevation="30dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/logo_font"
                    android:maxLines="1"
                    android:paddingStart="25dp"
                    android:text="@string/labib_ur_rahman"
                    android:textColor="@color/mainContainer_HeadingText"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:ignore="RtlSymmetry" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@string/sl_icon"
                    android:src="@drawable/sl_sort_right" />

            </LinearLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/leftGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="16dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/rightGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycleCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:scrollbars="none"
                app:layout_constraintEnd_toStartOf="@+id/rightGuideline"
                app:layout_constraintStart_toStartOf="@id/leftGuideline"
                app:layout_constraintTop_toBottomOf="@+id/btnProfile"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_features" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/carouselRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_tab_bar_orange_light"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnMyLibrary"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_bar_orange_active"
                android:fontFamily="@font/main_font_regular_2"
                android:gravity="center"
                android:paddingTop="2dp"
                android:text="@string/my_library"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMyFavorites"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_bar_orange_main"
                android:fontFamily="@font/main_font_regular_2"
                android:gravity="center"
                android:paddingTop="2dp"
                android:text="@string/my_favorites"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleBooks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_horizontal"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:scrollbars="none"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_book_grid" />

        <!-- ViewPager2 for dynamic height functionality -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>

        <!-- PageIndicatorView for dot indicators -->
        <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
            android:id="@+id/dots_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:dotsColor="@color/sideBar_InactiveBtn"
            app:dotsCornerRadius="8dp"
            app:dotsSize="10dp"
            app:dotsSpacing="4dp"
            app:dotsWidthFactor="2.5"
            app:selectedDotColor="@color/Coral"
            app:progressMode="true"
            android:layout_marginBottom="20dp"
            />

    </LinearLayout>

</ScrollView>