<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="-5dp"
            android:layout_marginEnd="-5dp"
            android:contentDescription="@string/home_page_top_background_image"
            android:scaleType="fitEnd"
            android:src="@drawable/bg_technology_top_red"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header Section -->

        <LinearLayout
            android:id="@+id/ic_menuBtn"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/circle_shadow_icon"
            android:elevation="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view"
            tools:targetApi="p">

            <ImageView
                android:src="@drawable/logo_orange_black"
                style="@style/dayNightLogo"
                android:contentDescription="@string/smart_engineer_logo" />

        </LinearLayout>

        <view
            android:id="@+id/view"
            class="android.widget.ImageView"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSmart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="-22dp"
            android:elevation="30dp"
            android:fontFamily="@font/logo_font"
            android:letterSpacing="0.0"
            android:text="@string/smart"
            android:textAllCaps="true"
            android:textColor="@color/mainContainer_HeadingText"
            android:textSize="33sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/ic_menuBtn"
            app:layout_constraintTop_toTopOf="@+id/ic_menuBtn" />

        <TextView
            android:id="@+id/tvE"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-34dp"
            android:elevation="30dp"
            android:fontFamily="@font/logo_font"
            android:letterSpacing="0.05"
            android:text="@string/e"
            android:textAllCaps="true"
            android:textColor="@color/mainContainer_HeadingText"
            android:textSize="33sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/tvSmart"
            app:layout_constraintTop_toBottomOf="@+id/tvSmart" />

        <TextView
            android:id="@+id/tvEngineer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:elevation="30dp"
            android:fontFamily="@font/logo_font"
            android:text="@string/ngineer"
            android:textAllCaps="true"
            android:textColor="@color/mainContainer_SubHeadingText"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/tvE"
            app:layout_constraintTop_toTopOf="@+id/tvE" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="30dp"
            android:fontFamily="@font/logo_font"
            android:text="@string/ing"
            android:textAllCaps="true"
            android:textColor="@color/mainContainer_SubHeadingText"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/tvEngineer"
            app:layout_constraintTop_toTopOf="@+id/tvEngineer" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:elevation="30dp"
            android:fontFamily="@font/logo_font"
            android:text="@string/learning_app"
            android:textAllCaps="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/mainContainer_SubHeadingText"
            app:layout_constraintBottom_toBottomOf="@+id/tvE"
            app:layout_constraintStart_toEndOf="@+id/tvE" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="70dp"
            android:contentDescription="@string/rocket"
            android:src="@drawable/rocket"
            app:layout_constraintBottom_toTopOf="@+id/tvSmart"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Polytechnic Section -->
        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rectangle_shadow_icon"
            android:elevation="40dp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvE">

            <TextView
                android:id="@+id/tvPoly"
                android:layout_width="165dp"
                android:layout_height="wrap_content"
                android:elevation="30dp"
                android:ellipsize="end"
                android:fontFamily="@font/logo_font"
                android:textColor="@color/mainContainer_HeadingText"
                android:maxLines="1"
                android:paddingLeft="25dp"
                android:text="Labib UR Rahman"
                android:textSize="16dp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:src="@drawable/sort_right_svgrepo_com" />

        </LinearLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/leftGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="16dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/rightGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintEnd_toStartOf="@+id/rightGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_features" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>