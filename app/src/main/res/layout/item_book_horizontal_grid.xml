<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clickNoticeItem"
    android:layout_width="200dp"
    android:layout_height="200dp"
    android:padding="13dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_book_item">


    <LinearLayout
        android:id="@+id/ll_itemBG"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_book_item_picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBookImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/smart_engineer_logo"
            android:padding="8dp"
            android:src="@drawable/logo_orange_black" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvBookName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/main_font_regular_2"
        android:maxLines="2"
        android:ellipsize="end"
        android:textStyle="bold"
        android:lineHeight="25dp"
        android:text="Programming in JavaScript"
        android:textColor="@color/mainContainer_HeadingText"
        android:textSize="19sp"
        app:layout_constraintBottom_toTopOf="@id/icLove"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_itemBG" />

    <ImageView
        android:id="@+id/menuImageView"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/love_button"
        android:src="@drawable/sl_heart_not_fill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_itemBG"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:fontFamily="@font/main_font_regular_2"
        android:text="@string/_21085"
        android:id="@+id/tvBookCode"
        android:textColor="@color/mainContainer_HeadingText"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/menuImageView"
        app:layout_constraintEnd_toStartOf="@+id/menuImageView"
        app:layout_constraintTop_toTopOf="@+id/menuImageView"
        app:layout_constraintVertical_bias="0.45" />

    <ImageView
        android:id="@+id/icLove"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@string/eye_icon"
        android:src="@drawable/sl_eye"
        app:layout_constraintBottom_toBottomOf="@+id/btnLove"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnLove"
        app:layout_constraintVertical_bias="0.70" />

    <TextView
        android:id="@+id/tvBookView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/main_font_regular_2"
        android:text="265"
        android:textColor="@color/mainContainer_HeadingText"
        android:textSize="14sp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/icLove"
        app:layout_constraintStart_toEndOf="@+id/icLove"
        app:layout_constraintTop_toTopOf="@+id/icLove" />

    <LinearLayout
        android:id="@+id/btnLove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_book_item_picture"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnTextLove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/main_font_regular_2"
            android:text="@string/read_now"
            android:textColor="#1C274C"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="@+id/icLove"
            app:layout_constraintStart_toEndOf="@+id/icLove"
            app:layout_constraintTop_toTopOf="@+id/icLove" />

        <ImageView
            android:id="@+id/btnIconLove"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/right_arrow"
            android:src="@drawable/sl_double_alt_arrow_right__black" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>