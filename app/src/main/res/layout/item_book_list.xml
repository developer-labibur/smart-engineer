<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="75dp"
    android:gravity="center"
    android:id="@+id/btnSemester"
    android:orientation="vertical"
    android:background="@color/sl_secoundary"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/tv1stLetter">

    <View
        android:id="@+id/bookView"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/blue_light_color"
        app:layout_constraintEnd_toStartOf="@+id/clickBookItem"
        app:layout_constraintHorizontal_bias="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvBookCode"
        style="@style/btn_features_text"
        android:background="@color/sl_secoundary"
        android:textSize="15sp"
        android:text="@string/_21085"
        app:layout_constraintBottom_toBottomOf="@id/bookView"
        app:layout_constraintStart_toStartOf="@id/bookView"
        app:layout_constraintEnd_toEndOf="@id/bookView"
        app:layout_constraintTop_toTopOf="@+id/bookView" />

    <ImageView
        android:id="@+id/semIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="@string/sl_icon"
        android:src="@drawable/sl_sort_right"
        app:layout_constraintBottom_toBottomOf="@+id/bookView"
        app:layout_constraintEnd_toStartOf="@+id/clickBookItem"
        app:layout_constraintTop_toTopOf="@+id/bookView"
        app:layout_constraintVertical_bias="0.53" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clickBookItem"
        android:layout_width="0dp"
        android:layout_height="69dp"
        android:layout_marginStart="60dp"
        android:background="@drawable/abc_blue_light"
        app:layout_constraintBottom_toBottomOf="@+id/bookView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_margin="8dp"
            android:id="@+id/ivBookImage"
            style="@style/btn_features_image"
            android:background="@drawable/abc_blue_main"
            android:contentDescription="@string/sl_icon"
            android:src="@drawable/number_one"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBookName"
            style="@style/btn_features_text"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="-3dp"
            android:text="@string/book_name"
            android:textAlignment="viewStart"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="@dimen/text_size_large"
            app:layout_constraintEnd_toStartOf="@+id/btnFavourite"
            app:layout_constraintStart_toEndOf="@+id/ivBookImage"
            app:layout_constraintTop_toTopOf="@id/ivBookImage" />

        <ImageView
            android:id="@+id/btnFavourite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="-12dp"
            android:padding="10dp"
            android:contentDescription="@string/sl_icon"
            android:src="@drawable/sl_heart_not_fill"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivBookImage" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:orientation="horizontal"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@id/ivBookImage"
            app:layout_constraintStart_toEndOf="@+id/ivBookImage"
            app:layout_constraintTop_toBottomOf="@id/tvBookName">

            <ImageView
                android:id="@+id/icLove"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@string/sl_icon"
                android:src="@drawable/sl_eye"
                app:layout_constraintBottom_toBottomOf="@+id/btnReadNow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btnReadNow"
                app:layout_constraintVertical_bias="0.70" />

            <TextView
                android:id="@+id/tvBookView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/main_font_regular_2"
                android:text="@string/_265"
                android:textColor="@color/sl_primary_text"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@+id/icLove"
                app:layout_constraintStart_toEndOf="@+id/icLove"
                app:layout_constraintTop_toTopOf="@+id/icLove" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/btnReadNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_weight="1"
            android:background="@drawable/abc_blue_main"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_margin="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/main_font_regular_2"
                android:text="@string/read_now"
                android:textColor="#1C274C"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@+id/icLove"
                app:layout_constraintStart_toEndOf="@+id/icLove"
                app:layout_constraintTop_toTopOf="@+id/icLove" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/smart_engineer_logo"
                android:src="@drawable/sl_double_alt_arrow_right__black" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
