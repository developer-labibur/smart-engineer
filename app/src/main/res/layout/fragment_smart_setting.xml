                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/btnViewPremium"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_weight="1" />

        </LinearLayout>

