                </LinearLayout>

                <ImageView
                    android:contentDescription="@string/sl_icon"
                    android:src="@drawable/sl_double_alt_arrow_right"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/setting_item_image_right" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Management ~~~~~~~~-> Text -->
            <LinearLayout
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/main_font_regular_2"
                    android:includeFontPadding="false"
                    android:text="@string/m"
                    android:textColor="@color/sl_action_text_middle_red"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
