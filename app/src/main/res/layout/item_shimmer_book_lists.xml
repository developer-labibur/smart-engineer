<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="75dp"
    android:gravity="center"
    android:id="@+id/btnSemester"
    android:orientation="vertical"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/tv1stLetter">

    <View
        android:id="@+id/bookView"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/shimmer"
        app:layout_constraintEnd_toStartOf="@+id/clickBookItem"
        app:layout_constraintHorizontal_bias="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/tvBookCode"
        android:layout_width="35dp"
        android:layout_height="15dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/shimmer"
        app:layout_constraintBottom_toBottomOf="@id/bookView"
        app:layout_constraintStart_toStartOf="@id/bookView"
        app:layout_constraintEnd_toEndOf="@id/bookView"
        app:layout_constraintTop_toTopOf="@+id/bookView" />

    <androidx.cardview.widget.CardView
        android:id="@+id/clickBookItem"
        android:layout_width="0dp"
        android:layout_height="69dp"
        android:layout_marginStart="60dp"
        app:cardCornerRadius="15dp"
        app:cardBackgroundColor="@color/shimmer_light"
        app:layout_constraintBottom_toBottomOf="@+id/bookView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:layout_margin="8dp"
                android:id="@+id/ivBookImage"
                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="@color/shimmer"
                style="@style/btn_features_image"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/tvBookName"
                android:layout_width="150dp"
                android:background="@color/shimmer"
                android:layout_height="15dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="3dp"
                app:layout_constraintStart_toEndOf="@+id/ivBookImage"
                app:layout_constraintTop_toTopOf="@id/ivBookImage" />

            <androidx.cardview.widget.CardView
                android:id="@+id/btnFavourite"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:cardCornerRadius="5dp"
                app:cardBackgroundColor="@color/shimmer"
                android:layout_marginEnd="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivBookImage" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:orientation="horizontal"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@id/ivBookImage"
                app:layout_constraintStart_toEndOf="@+id/ivBookImage"
                app:layout_constraintTop_toBottomOf="@id/tvBookName">

                <androidx.cardview.widget.CardView
                    android:id="@+id/icLove"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:cardBackgroundColor="@color/shimmer"
                    app:cardCornerRadius="5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnReadNow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/btnReadNow"
                    app:layout_constraintVertical_bias="0.70" />

                <View
                    android:id="@+id/tvBookView"
                    android:layout_width="50dp"
                    android:layout_height="15dp"
                    android:background="@color/shimmer"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/icLove"
                    app:layout_constraintStart_toEndOf="@+id/icLove"
                    app:layout_constraintTop_toTopOf="@+id/icLove" />

            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:id="@+id/btnReadNow"
                android:layout_width="80dp"
                android:layout_height="17dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="@color/shimmer"
                android:layout_margin="7dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>
