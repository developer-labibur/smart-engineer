<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogForgot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="25dp"
    android:background="@color/transparent"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/layBlur"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_coming_soon"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="wrap_content"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:contentDescription="@string/sl_icon"
            android:src="@drawable/coming_soon"/>

        <TextView
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/hind_siliguri"
            android:gravity="center"
            android:text="@string/coming_soon_text"
            android:textColor="#FFA85C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOk"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="40dp"
            android:text="@string/ok"
            android:fontFamily="@font/main_font_regular_2"
            android:textColor="#FFA85C"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="17sp"
            android:background="@drawable/bg_coming_soon_button"
            />


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>