<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sl_secondary"
    tools:context=".ui.activities.BookDetailsActivity">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerDetails"
        android:layout_width="0dp"
        android:layout_marginBottom="10dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/adViewContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/sl_secondary"
            android:scrollbars="none">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cH"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:layout_width="100dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="1dp"
                    android:background="@color/sl_primary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_book_ber_bottom_left_radius"
                    app:layout_constraintBottom_toTopOf="@+id/btt"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/bb"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="@color/shimmer"
                        app:cardCornerRadius="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/shimmerTvBookTitle"
                        android:layout_width="160dp"
                        android:layout_height="25dp"
                        android:layout_marginTop="27dp"
                        android:background="@color/shimmer"
                        app:layout_constraintEnd_toStartOf="@+id/bp"
                        app:layout_constraintStart_toEndOf="@+id/bb"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/bp"
                        android:layout_width="80dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:cardBackgroundColor="@color/shimmer"
                        app:cardCornerRadius="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/bi"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="30dp"
                        android:background="@color/shimmer"
                        android:contentDescription="@string/book_cover"
                        android:src="@drawable/book"
                        app:layout_constraintStart_toStartOf="@+id/bb"
                        app:layout_constraintTop_toBottomOf="@+id/bb" />

                    <View
                        android:id="@+id/iB"
                        style="@style/sl_header_button"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="0dp"
                        android:background="@color/shimmer"
                        app:layout_constraintStart_toEndOf="@+id/bi"
                        app:layout_constraintTop_toTopOf="@+id/bi" />

                    <View
                        android:id="@+id/bc"
                        android:layout_width="120dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/shimmer"
                        app:layout_constraintBottom_toBottomOf="@+id/iB"
                        app:layout_constraintStart_toEndOf="@+id/iB"
                        app:layout_constraintTop_toTopOf="@+id/iB"
                        app:layout_constraintVertical_bias="0.36" />

                    <View
                        android:id="@+id/iv"
                        style="@style/sl_header_button"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="0dp"
                        android:background="@color/shimmer"
                        app:layout_constraintStart_toEndOf="@+id/bi"
                        app:layout_constraintTop_toBottomOf="@+id/bc" />

                    <View
                        android:id="@+id/vc"
                        android:layout_width="90dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/shimmer"
                        app:layout_constraintBottom_toBottomOf="@+id/iv"
                        app:layout_constraintStart_toEndOf="@+id/iv"
                        app:layout_constraintTop_toTopOf="@+id/iv"
                        app:layout_constraintVertical_bias="0.36" />

                    <View
                        android:id="@+id/ic"
                        style="@style/sl_header_button"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="0dp"
                        android:background="@color/shimmer"
                        app:layout_constraintStart_toEndOf="@+id/bi"
                        app:layout_constraintTop_toBottomOf="@+id/vc" />

                    <TextView
                        android:layout_width="105dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/shimmer"
                        app:layout_constraintBottom_toBottomOf="@+id/ic"
                        app:layout_constraintStart_toEndOf="@+id/ic"
                        app:layout_constraintTop_toTopOf="@+id/ic"
                        app:layout_constraintVertical_bias="0.36" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btt"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_book_ber_top_right_radius"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <View
                        android:id="@+id/ut"
                        style="@style/sl_header_button"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="25dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="0dp"
                        android:background="@color/shimmer"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/shimmer"
                        app:layout_constraintBottom_toBottomOf="@+id/ut"
                        app:layout_constraintStart_toEndOf="@+id/ut"
                        app:layout_constraintTop_toTopOf="@+id/ut"
                        app:layout_constraintVertical_bias="0.36" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="45dp"
                        android:layout_height="22dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="30dp"
                        android:paddingTop="2dp"
                        app:cardBackgroundColor="@color/shimmer"
                        app:cardCornerRadius="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <include
                android:id="@+id/shimmerUnitListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/sl_primary"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                layout="@layout/item_shimmer_unit_list"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cH"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <ScrollView
        android:id="@+id/bookDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:background="@color/sl_secondary"
        android:layout_marginBottom="10dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/adViewContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:layout_width="100dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="1dp"
                    android:background="@color/sl_primary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clInfoBook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="20dp"
                    android:background="@drawable/bg_book_ber_bottom_left_radius"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/abc_orange_light"
                        android:contentDescription="@string/sl_icon"
                        android:paddingStart="9dp"
                        android:paddingEnd="11dp"
                        android:src="@drawable/sl_left_arrow_back"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvBookTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/main_font_regular_2"
                        android:singleLine="true"
                        android:text="@string/book_details"
                        android:textAlignment="textStart"
                        android:textColor="@color/mainContainer_HeadingText"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
                        app:layout_constraintEnd_toStartOf="@+id/btnPremium"
                        app:layout_constraintStart_toEndOf="@+id/btnBack"
                        app:layout_constraintTop_toTopOf="@+id/btnBack" />


                    <!-- Membership Plus -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnPremium"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/abc_orange_light"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:id="@+id/ll_premium_icon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_sl_premium_box_golden"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/animationView"
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:contentDescription="@string/engineer_pro"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/anim_premium_crown" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPremium"
                            style="@style/dashboard_smart_point_text"
                            android:text="@string/engineer_pro"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/ll_premium_icon"
                            app:layout_constraintTop_toTopOf="@+id/ll_premium_icon" />

                        <TextView
                            android:id="@+id/tvRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="@font/main_font_regular_2"
                            android:includeFontPadding="false"
                            android:textColor="@color/sl_primary_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@+id/ll_premium_icon"
                            app:layout_constraintStart_toEndOf="@+id/ll_premium_icon"
                            app:layout_constraintTop_toBottomOf="@+id/tvPremium" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:id="@+id/bookCoverImage"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="30dp"
                        android:contentDescription="@string/book_cover"
                        android:src="@drawable/book"
                        app:layout_constraintStart_toStartOf="@+id/btnBack"
                        app:layout_constraintTop_toBottomOf="@+id/btnBack" />

                    <ImageView
                        android:id="@+id/icBook"
                        style="@style/sl_header_button"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="0dp"
                        android:contentDescription="@string/sl_icon"
                        android:src="@drawable/sl_notebook"
                        app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
                        app:layout_constraintTop_toTopOf="@+id/bookCoverImage" />

                    <TextView
                        android:id="@+id/bookCodes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="15dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/main_font_regular_2"
                        android:lineSpacingExtra="-7dp"
                        android:maxLines="3"
                        android:text="@string/book_name"
                        android:textSize="@dimen/_16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/icBook"
                        app:layout_constraintTop_toTopOf="@+id/icBook" />

                    <ImageView
                        android:id="@+id/icView"
                        style="@style/sl_header_button"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/sl_icon"
                        android:src="@drawable/sl_eye"
                        app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
                        app:layout_constraintTop_toBottomOf="@+id/bookCodes" />

                    <TextView
                        android:id="@+id/viewCountTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/main_font_regular_2"
                        android:text="@string/total_reads"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@+id/icView"
                        app:layout_constraintStart_toEndOf="@+id/icView"
                        app:layout_constraintTop_toTopOf="@+id/icView"
                        app:layout_constraintVertical_bias="0.36" />

                    <ImageView
                        android:id="@+id/icCredit"
                        style="@style/sl_header_button"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/sl_icon"
                        android:src="@drawable/sl_notes"
                        app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
                        app:layout_constraintTop_toBottomOf="@+id/viewCountTextView" />

                    <TextView
                        android:id="@+id/viewCountTextCredit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/main_font_regular_2"
                        android:text="@string/book_credit"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@+id/icCredit"
                        app:layout_constraintStart_toEndOf="@+id/icCredit"
                        app:layout_constraintTop_toTopOf="@+id/icCredit"
                        app:layout_constraintVertical_bias="0.36" />

                    <TextView
                        android:id="@+id/disclaimerText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="20dp"
                        android:background="@drawable/abc_orange_light"
                        android:gravity="center"
                        android:padding="10dp"
                        android:fontFamily="@font/bengali"
                        android:text="@string/note_book_details"
                        android:textColor="@color/sl_primary_text"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/bookCoverImage" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clUnitHeader"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_book_ber_top_right_radius"
                    app:layout_constraintTop_toBottomOf="@id/clInfoBook"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="25dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="-15dp"
                        android:drawablePadding="10dp"
                        android:fontFamily="@font/main_font_regular_2"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:text="@string/units"
                        android:textColor="@color/mainContainer_HeadingText"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/sl_notebook_bookmark_fill"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="25dp"
                        android:paddingTop="2dp"
                        android:background="@drawable/bg_sl_m_orange"
                        app:cardCornerRadius="50dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/bookTotalUnits"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_marginEnd="15dp"
                            android:fontFamily="@font/main_font_regular_2"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:text="@string/_07"
                            android:textColor="@color/pdf_text_light"
                            android:textSize="16sp" />

                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clUnitList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clHeader">

                <!-- RecyclerView for Units -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/unitContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_book_ber_bottom_right_radius"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/unitRecyclerView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-1dp"
                        android:background="@drawable/bg_book_ber_bottom_right_radius"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="vertical"
                        android:overScrollMode="never"
                        android:paddingStart="5dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="15dp"
                        android:scrollbars="none"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:itemCount="2"
                        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_book_unit" />

                    <TextView
                        android:id="@+id/tvNoUnit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="28dp"
                        android:layout_marginEnd="30dp"
                        android:fontFamily="@font/bengali"
                        android:orientation="horizontal"
                        android:textColor="@color/mainContainer_HeadingText"
                        android:textStyle="bold"
                        android:scrollbars="none"
                        android:visibility="invisible"
                        android:paddingBottom="20dp"
                        android:text="@string/book_unit_list_is_empty"
                        android:textSize="@dimen/_16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:layout_marginBottom="-1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/unitContainer">

                    <View
                        android:id="@+id/view2"
                        android:layout_width="100dp"
                        android:layout_height="0dp"
                        android:layout_marginBottom="2dp"
                        android:background="@color/sl_primary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clUnitBottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_book_ber_top_left_radius"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <!-- Book Description -->
                        <TextView
                            android:id="@+id/tvDes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="25dp"
                            android:layout_marginTop="25dp"
                            android:drawablePadding="10dp"
                            android:fontFamily="@font/main_font_regular_2"
                            android:gravity="center_vertical"
                            android:singleLine="true"
                            android:text="@string/description"
                            android:textColor="@color/mainContainer_HeadingText"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/sl_book_info"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="15dp"
                            android:fontFamily="@font/bengali"
                            android:orientation="horizontal"
                            android:scrollbars="none"
                            android:text="@string/book_details_is_empty"
                            android:textSize="@dimen/_16sp"
                            android:textColor="@color/mainContainer_HeadingText"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tvDes"
                            app:layout_constraintTop_toBottomOf="@+id/tvDes" />

                        <!-- Department -->
                        <TextView
                            android:id="@+id/tvDepartment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="25dp"
                            android:layout_marginTop="10dp"
                            android:drawablePadding="10dp"
                            android:fontFamily="@font/main_font_regular_2"
                            android:gravity="center_vertical"
                            android:singleLine="true"
                            android:text="@string/department"
                            android:textColor="@color/mainContainer_HeadingText"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/sl_notebook_department"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvInfo" />

                        <HorizontalScrollView
                            android:id="@+id/nestedDep"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="25dp"
                            android:orientation="horizontal"
                            android:scrollbars="none"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tvDepartment"
                            app:layout_constraintTop_toBottomOf="@+id/tvDepartment">

                            <LinearLayout
                                android:id="@+id/tagContainerXDep"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                        </HorizontalScrollView>

                        <!-- Semester -->
                        <TextView
                            android:id="@+id/tvSemester"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="25dp"
                            android:layout_marginTop="10dp"
                            android:drawablePadding="10dp"
                            android:fontFamily="@font/main_font_regular_2"
                            android:gravity="center_vertical"
                            android:singleLine="true"
                            android:text="@string/tag"
                            android:textColor="@color/mainContainer_HeadingText"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/sl_hashtag_square"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/nestedDep" />

                        <HorizontalScrollView
                            android:id="@+id/nestedSem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="25dp"
                            android:orientation="horizontal"
                            android:paddingBottom="30dp"
                            android:scrollbars="none"
                            android:contentDescription="@string/semester_tag_name"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tvSemester"
                            app:layout_constraintTop_toBottomOf="@+id/tvSemester">

                            <LinearLayout
                                android:id="@+id/tagContainerXSem"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                        </HorizontalScrollView>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


