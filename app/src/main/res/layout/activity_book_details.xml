<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sl_secoundary"
    android:scrollbars="none"
    tools:context=".view.BookDetailsActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clHeader"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="100dp"
                android:layout_height="0dp"
                android:layout_marginBottom="1dp"
                android:background="#181d3d"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_book_ber_bottom_left_radius"
                app:layout_constraintBottom_toTopOf="@+id/btnBack3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_height="40dp"
                    android:layout_width="40dp"
                    android:background="@drawable/bg_sl_profile_text_golden"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:contentDescription="@string/sl_icon"
                    android:src="@drawable/sl_left_arrow_back"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tvBookTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/main_font_regular_2"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/book_name"
                    android:textColor="@color/mainContainer_HeadingText"
                    android:textSize="22sp"
                    android:textAlignment="textStart"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/btnPremium"
                    app:layout_constraintStart_toEndOf="@+id/btnBack"
                    app:layout_constraintTop_toTopOf="parent" />


                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerTvBookTitle"
                    android:layout_width="170dp"
                    android:layout_height="25dp"
                    android:layout_marginTop="27dp"
                    android:background="@color/shimmer"
                    app:layout_constraintEnd_toStartOf="@+id/btnPremium"
                    app:layout_constraintStart_toEndOf="@+id/btnBack"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Membership Plus -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnPremium"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sl_profile_text_golden"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:id="@+id/ll_premium_icon"
                        android:layout_width="33dp"
                        android:layout_height="33dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_sl_profile_box_golden"
                        android:orientation="horizontal"
                        android:gravity="center"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/animationView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:lottie_url="https://lottie.host/e64c0a22-b913-4a0d-bc5e-daa768ca93fd/8DGaZDmvma.lottie"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPremium"
                        style="@style/dashboard_smart_point_text"
                        android:fontFamily="@font/roboto"
                        android:text="@string/_00"
                        android:textSize="16sp"
                        android:layout_marginTop="3dp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@+id/ll_premium_icon"
                        app:layout_constraintTop_toTopOf="@+id/ll_premium_icon" />

                    <TextView
                        android:id="@+id/tvTaka"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="5dp"
                        android:fontFamily="@font/main_font_regular_2"
                        android:includeFontPadding="false"
                        android:text="Points"
                        android:layout_marginEnd="10dp"
                        android:textColor="@color/sl_primary_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/ll_premium_icon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ll_premium_icon"
                        app:layout_constraintTop_toBottomOf="@+id/tvPremium" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageView
                    android:id="@+id/bookCoverImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="30dp"
                    android:contentDescription="@string/book_cover"
                    android:src="@drawable/book"
                    app:layout_constraintStart_toStartOf="@+id/btnBack"
                    app:layout_constraintTop_toBottomOf="@+id/btnBack" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerBookCoverImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="30dp"
                    android:background="@color/shimmer"
                    android:contentDescription="@string/book_cover"
                    app:layout_constraintStart_toStartOf="@+id/btnBack"
                    app:layout_constraintTop_toBottomOf="@+id/btnBack" />

                <ImageView
                    android:id="@+id/icBook"
                    style="@style/sl_header_button"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="@string/sl_icon"
                    android:src="@drawable/sl_notebook"
                    app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
                    app:layout_constraintTop_toTopOf="@+id/bookCoverImage" />


                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerIcBook"
                    style="@style/sl_header_button"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="15dp"
                    android:visibility="visible"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="0dp"
                    android:background="@color/shimmer"
                    app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
                    app:layout_constraintTop_toTopOf="@+id/bookCoverImage" />

                <TextView
                    android:id="@+id/bookCodes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/subject_code"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icBook"
                    app:layout_constraintStart_toEndOf="@+id/icBook"
                    app:layout_constraintTop_toTopOf="@+id/icBook"
                    app:layout_constraintVertical_bias="0.36" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerBookCodes"
                    android:layout_width="120dp"
                    android:layout_height="20dp"
                    android:visibility="visible"
                    android:background="@color/shimmer"
                    app:layout_constraintBottom_toBottomOf="@+id/icBook"
                    app:layout_constraintStart_toEndOf="@+id/icBook"
                    app:layout_constraintTop_toTopOf="@+id/icBook"
                    app:layout_constraintVertical_bias="0.36" />

                <ImageView
                    android:id="@+id/icView"
                    style="@style/sl_header_button"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/sl_icon"
                    android:src="@drawable/sl_eye"
                    app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
                    app:layout_constraintTop_toBottomOf="@+id/icBook" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerIcView"
                    style="@style/sl_header_button"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="15dp"
                    android:visibility="visible"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="0dp"
                    android:background="@color/shimmer"
                    android:contentDescription="@string/sl_icon"
                    app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
                    app:layout_constraintTop_toBottomOf="@+id/icBook" />

                <TextView
                    android:id="@+id/viewCountTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/total_reads"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icView"
                    app:layout_constraintStart_toEndOf="@+id/icView"
                    app:layout_constraintTop_toTopOf="@+id/icView"
                    app:layout_constraintVertical_bias="0.36" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerViewCountTextView"
                    android:layout_width="90dp"
                    android:layout_height="20dp"
                    android:visibility="visible"
                    android:background="@color/shimmer"
                    app:layout_constraintBottom_toBottomOf="@+id/icView"
                    app:layout_constraintStart_toEndOf="@+id/icView"
                    app:layout_constraintTop_toTopOf="@+id/icView"
                    app:layout_constraintVertical_bias="0.36" />

                <ImageView
                    android:id="@+id/icCalander"
                    style="@style/sl_header_button"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/sl_icon"
                    android:src="@drawable/sl_calendar"
                    app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
                    app:layout_constraintTop_toBottomOf="@+id/icView" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerIcCalander"
                    style="@style/sl_header_button"
                    android:layout_width="25dp"
                    android:visibility="visible"
                    android:layout_height="25dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="0dp"
                    android:background="@color/shimmer"
                    android:contentDescription="@string/sl_icon"
                    app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
                    app:layout_constraintTop_toBottomOf="@+id/icView" />

                <TextView
                    android:id="@+id/dataUploaded"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:text="@string/my_birthday"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icCalander"
                    app:layout_constraintStart_toEndOf="@+id/icCalander"
                    app:layout_constraintTop_toTopOf="@+id/icCalander"
                    app:layout_constraintVertical_bias="0.45" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerDataUploaded"
                    android:layout_width="110dp"
                    android:layout_height="20dp"
                    android:background="@color/shimmer"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="@+id/icCalander"
                    app:layout_constraintStart_toEndOf="@+id/icCalander"
                    app:layout_constraintTop_toTopOf="@+id/icCalander"
                    app:layout_constraintVertical_bias="0.45" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnBack3"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_book_ber_top_right_radius"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="-15dp"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/main_font_regular_2"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text="@string/units"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/sl_notebook_bookmark_unit_fill"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="30dp"
                    app:cardBackgroundColor="#2d325a"
                    app:cardCornerRadius="50dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/bookTotalUnits"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:fontFamily="@font/main_font_regular_2"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="@string/_07"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                </androidx.cardview.widget.CardView>


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/shimmerUnitListContainer"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clHeader"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="#181d3d"
             android:layout_width="0dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerUnitList"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shimmer_duration="800">

                <include
                    layout="@layout/item_shimmer_unit_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </com.facebook.shimmer.ShimmerFrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clUnitList"
            android:layout_width="0dp"
            android:visibility="visible"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clHeader">

            <!-- RecyclerView for Units -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/unitRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingEnd="0dp"
                android:paddingBottom="15dp"
                android:layout_marginTop="-1dp"
                android:clipToPadding="false"
                android:background="@drawable/bg_book_ber_bottom_right_radius"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"
                android:overScrollMode="never"
                android:scrollbars="none"
                tools:itemCount="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_book_unit" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:layout_marginBottom="-1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/unitRecyclerView">

                <View
                    android:id="@+id/view2"
                    android:layout_width="100dp"
                    android:layout_height="0dp"
                    android:background="#181d3d"
                    android:layout_marginBottom="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clUnitBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_book_ber_top_left_radius"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Book Description -->
                    <TextView
                        android:id="@+id/tvDes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="25dp"
                        android:layout_marginTop="25dp"
                        android:drawablePadding="10dp"
                        android:fontFamily="@font/main_font_regular_2"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:text="@string/description"
                        android:textColor="@color/mainContainer_HeadingText"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/sl_book_info"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="15dp"
                        android:layout_marginStart="4dp"
                        android:orientation="horizontal"
                        android:text="@string/just_for_you_info_text"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:scrollbars="none"
                        android:fontFamily="@font/hind_siliguri"
                        app:layout_constraintStart_toStartOf="@+id/tvDes"
                        app:layout_constraintTop_toBottomOf="@+id/tvDes" />

                    <!-- Department -->
                    <TextView
                        android:id="@+id/tvDepartment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="25dp"
                        android:layout_marginTop="10dp"
                        android:drawablePadding="10dp"
                        android:fontFamily="@font/main_font_regular_2"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:text="@string/department"
                        android:textColor="@color/mainContainer_HeadingText"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/sl_notebook_department"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvInfo" />

                    <HorizontalScrollView
                        android:id="@+id/nestedDep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="25dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:scrollbars="none"
                        app:layout_constraintStart_toStartOf="@+id/tvDepartment"
                        app:layout_constraintTop_toBottomOf="@+id/tvDepartment" >

                        <LinearLayout
                            android:id="@+id/tagContainerXDep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"/>

                    </HorizontalScrollView>

                    <!-- Semester -->
                    <TextView
                        android:id="@+id/tvSemester"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="25dp"
                        android:drawablePadding="10dp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/main_font_regular_2"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:text="@string/tag"
                        android:textColor="@color/mainContainer_HeadingText"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/sl_hashtag_square"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/nestedDep" />

                    <HorizontalScrollView
                        android:id="@+id/nestedSem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="25dp"
                        android:paddingBottom="30dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:scrollbars="none"
                        app:layout_constraintStart_toStartOf="@+id/tvSemester"
                        app:layout_constraintTop_toBottomOf="@+id/tvSemester" >

                        <LinearLayout
                            android:id="@+id/tagContainerXSem"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"/>

                    </HorizontalScrollView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>


