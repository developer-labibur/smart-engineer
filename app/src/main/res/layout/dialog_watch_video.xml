<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogForgot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center">

    <View
        android:id="@+id/layBlur"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:layout_margin="20dp"
        android:background="@drawable/dialog_green_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTitleBonus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/hind_siliguri"
        android:lineSpacingExtra="-8dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="-10dp"
        android:gravity="center"
        android:text="Not Enough Points"
        android:textColor="@color/mainContainer_HeadingText"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/layBlur"
        app:layout_constraintStart_toStartOf="@+id/layBlur"
        app:layout_constraintTop_toBottomOf="@+id/lottieAnimationView" />

    <TextView
        android:id="@+id/tvWatchInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/roboto"
        android:text="@string/do_not_have_enough_points"
        android:textColor="@color/mainContainer_SubHeadingText"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="@id/tvTitleBonus"
        app:layout_constraintStart_toStartOf="@+id/tvTitleBonus"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleBonus" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimationView"
        android:layout_width="180dp"
        android:layout_height="130dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@+id/layBlur"
        app:layout_constraintStart_toStartOf="@+id/layBlur"
        app:layout_constraintTop_toTopOf="@+id/layBlur"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/diamond" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="41dp"
        android:layout_margin="15dp"
        android:background="@drawable/abc_orange_light"
        app:layout_constraintBottom_toBottomOf="@+id/layBlur"
        app:layout_constraintStart_toStartOf="@+id/layBlur">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:fontFamily="@font/hind_siliguri"
            android:gravity="center_vertical"
            android:paddingStart="1dp"
            android:paddingEnd="15dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/mainContainer_HeadingText"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/sl_left_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnWatchAds"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginEnd="15dp"
        android:layout_marginStart="15dp"
        android:background="@drawable/abc_orange_main"
        app:layout_constraintBottom_toBottomOf="@+id/btnClose"
        app:layout_constraintEnd_toEndOf="@+id/layBlur"
        app:layout_constraintStart_toEndOf="@+id/btnClose">

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fontFamily="@font/hind_siliguri"
            android:gravity="center_vertical"
            android:text="Watch Video"
            android:layout_marginEnd="5dp"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivVideoAds"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivVideoAds"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/sl_video_library"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <ImageView
        android:layout_width="75dp"
        android:layout_height="65dp"
        android:layout_marginBottom="-20dp"
        android:src="@drawable/cute_cat"
        app:layout_constraintBottom_toTopOf="@+id/layBlur"
        app:layout_constraintEnd_toEndOf="@+id/layBlur"
        app:layout_constraintStart_toStartOf="@+id/layBlur" />

</androidx.constraintlayout.widget.ConstraintLayout>