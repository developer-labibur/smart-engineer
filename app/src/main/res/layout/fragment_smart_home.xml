<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@color/transparent"
    tools:context=".ui.fragments.SmartHomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent">

        <!-- Top View -->
        <LinearLayout
            android:id="@+id/llTopView"
            android:layout_width="0dp"
            android:layout_height="@dimen/topGap"
            android:background="@color/transparent"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/btnViewProfile"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:contentDescription="@string/opens_user_profile" />

            <View
                android:id="@+id/btnViewPremium"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:contentDescription="@string/view_fremimum_screen" />

        </LinearLayout>

        <!-- Main Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@drawable/bg_sl_scroll_box_golden"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llTopView" >

            <!-- App Features -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Routine -->
                <LinearLayout
                    android:id="@+id/btnRoutine"
                    style="@style/btn_features_layout"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        style="@style/btn_features_image"
                        android:background="@drawable/bg_sl_m_orange"
                        android:contentDescription="@string/sl_icon"
                        android:src="@drawable/z_time_management" />

                    <TextView
                        style="@style/btn_features_text"
                        android:text="@string/routine" />

                </LinearLayout>

                <!-- Notify -->
                <LinearLayout
                    android:id="@+id/btnNotify"
                    style="@style/btn_features_layout"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnPosts"
                    app:layout_constraintStart_toEndOf="@+id/btnRoutine"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        style="@style/btn_features_image"
                        android:background="@drawable/bg_sl_m_green"
                        android:contentDescription="@string/sl_icon"
                        android:src="@drawable/z_notification_blue" />

                    <TextView
                        style="@style/btn_features_text"
                        android:text="@string/notify" />

                </LinearLayout>

                <!-- Posts -->
                <LinearLayout
                    android:id="@+id/btnPosts"
                    style="@style/btn_features_layout"
                    app:layout_constraintEnd_toStartOf="@+id/btnFavourites"
                    app:layout_constraintStart_toEndOf="@+id/btnNotify"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        style="@style/btn_features_image"
                        android:background="@drawable/bg_sl_m_blue"
                        android:contentDescription="@string/sl_icon"
                        android:src="@drawable/z_caption" />

                    <TextView
                        style="@style/btn_features_text"
                        android:text="@string/post" />

                </LinearLayout>

                <!-- Favourites -->
                <LinearLayout
                    android:id="@+id/btnFavourites"
                    style="@style/btn_features_layout"
                    app:layout_constraintEnd_toStartOf="@+id/btnIslamic"
                    app:layout_constraintStart_toEndOf="@+id/btnPosts"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        style="@style/btn_features_image"
                        android:background="@drawable/bg_sl_m_orange"
                        android:contentDescription="@string/sl_icon"
                        android:src="@drawable/z_favourite"/>

                    <TextView
                        style="@style/btn_features_text"
                        android:text="@string/favorites" />

                </LinearLayout>

                <!-- Islamic -->
                <LinearLayout
                    android:id="@+id/btnIslamic"
                    style="@style/btn_features_layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        style="@style/btn_features_image"
                        android:background="@drawable/bg_sl_m_red"
                        android:contentDescription="@string/sl_icon"
                        android:src="@drawable/z_kaaba" />

                    <TextView
                        style="@style/btn_features_text"
                        android:text="@string/islamic" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Marquee Notice -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clMarquee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:contentDescription="@string/marquee_announcement"
                android:background="@drawable/sl_search_box_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout3">

                <ImageView
                    android:id="@+id/imageView3"
                    style="@style/btn_features_image"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/sl_search_box_icon"
                    android:contentDescription="@string/signal_icon"
                    android:padding="2dp"
                    android:src="@drawable/live"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/marqueeTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="5dp"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/bengali"
                    android:textColor="@color/sl_primary_text"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView3"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- F -> Text -->
            <TextView
                android:id="@+id/tvD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/main_font_regular_2"
                android:includeFontPadding="false"
                android:text="@string/f"
                android:textColor="@color/sl_action_text_middle_red"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clMarquee" />

            <!-- eatures -> Text -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/main_font_regular_2"
                android:includeFontPadding="false"
                android:text="@string/eatures"
                android:textColor="@color/sl_primary_text"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tvD"
                app:layout_constraintStart_toEndOf="@+id/tvD"
                app:layout_constraintTop_toTopOf="@+id/tvD" />

            <!-- Features Icon -->
            <ImageView
                android:id="@+id/icDep"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/fire_icon"
                android:src="@drawable/sl_fire_fill"
                app:layout_constraintBottom_toBottomOf="@+id/tvD"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvD" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/homeContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvD">


                <!-- Department Section -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycleFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:foregroundGravity="center"
                    android:overScrollMode="never"
                    app:spanCount="1"
                    tools:itemCount="9"
                    android:scrollbars="none"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_feature"/>

                <!-- B -> Text -->
                <TextView
                    android:id="@+id/tvJ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/changa_variable_wght"
                    android:includeFontPadding="false"
                    android:text="@string/b"
                    android:textColor="@color/sl_action_text_middle_red"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/recycleFeatures" />

                <!-- rowse -> Text -->
                <TextView
                    android:id="@+id/tvFullLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/main_font_regular_2"
                    android:includeFontPadding="false"
                    android:text="@string/rowse"
                    android:textColor="@color/sl_primary_text"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/tvJ"
                    app:layout_constraintStart_toEndOf="@+id/tvJ"
                    app:layout_constraintTop_toTopOf="@+id/tvJ" />

                <!-- Browse Icon -->
                <ImageView
                    android:id="@+id/icJust"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/sl_icon"
                    android:src="@drawable/sl_earth"
                    app:layout_constraintBottom_toBottomOf="@+id/tvFullLetter"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvFullLetter" />

                <!-- Disclaimer Header -->
                <LinearLayout
                    android:id="@+id/browseDisclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_setting_item"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvJ"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/note_browse_h1"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/sl_primary_text"
                        android:fontFamily="@font/hind_siliguri"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/note_browse_h2"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:fontFamily="@font/hind_siliguri"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/sl_primary_text"/>

                </LinearLayout>

                <!-- Browse Cat Section -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycleBrowser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_horizontal"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/browseDisclaimer"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_browse_list"
                    tools:itemCount="3"/>

                <!-- Footer Gap View -->
                <View
                    android:id="@+id/viewFooter"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recycleBrowser"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Cat Icon View -->
        <View
            android:layout_width="75dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_sl_cat_golden"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llTopView" />

        <!-- Cat Icon -->
        <LinearLayout
            android:id="@+id/ll_cat"
            android:layout_width="80dp"
            android:layout_height="43dp"
            android:layout_margin="5dp"
            android:orientation="horizontal"
            android:paddingBottom="3dp"
            app:layout_constraintBottom_toTopOf="@+id/clContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.49"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/clContainer">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/meaw_image"
                android:src="@drawable/cute_cat" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>