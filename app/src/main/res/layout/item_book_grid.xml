<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clickBookItem"
    android:layout_width="match_parent"
    android:layout_height="145dp"
    android:layout_gravity="center_horizontal"
    android:layout_margin="5dp"
    android:background="@drawable/abc_orange_light"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/ll_itemBG"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@drawable/abc_orange_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBookImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/smart_engineer_logo"
            android:padding="7dp"
            android:src="@drawable/logo_orange_black" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvBookCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/hind_siliguri"
        android:text="@string/_21085"
        android:textColor="@color/sl_primary_text"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnFavourite"
        app:layout_constraintEnd_toStartOf="@+id/btnFavourite"
        app:layout_constraintTop_toTopOf="@+id/btnFavourite" />

    <ImageView
        android:id="@+id/btnFavourite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="-5dp"
        android:padding="10dp"
        android:contentDescription="@string/sl_icon"
        android:src="@drawable/sl_heart_not_fill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_itemBG" />

    <TextView
        android:id="@+id/tvBookName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/main_font_regular_2"
        android:lineSpacingExtra="-8dp"
        android:maxLines="2"
        android:minLines="2"
        android:gravity="center_vertical"
        android:text="@string/book_name"
        android:textColor="@color/sl_primary_text"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnReadNow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_itemBG" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/btnReadNow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnReadNow">

        <ImageView
            android:id="@+id/icLove"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/sl_icon"
            android:src="@drawable/sl_eye"
            app:layout_constraintBottom_toBottomOf="@+id/btnReadNow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnReadNow"
            app:layout_constraintVertical_bias="0.70" />

        <TextView
            android:id="@+id/tvBookView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/main_font_regular_2"
            android:text="@string/_265"
            android:textColor="@color/sl_primary_text"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/icLove"
            app:layout_constraintStart_toEndOf="@+id/icLove"
            app:layout_constraintTop_toTopOf="@+id/icLove" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnReadNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_weight="1"
        android:background="@drawable/abc_orange_main"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/main_font_regular_2"
            android:text="@string/read_now"
            android:textColor="#1C274C"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@+id/icLove"
            app:layout_constraintStart_toEndOf="@+id/icLove"
            app:layout_constraintTop_toTopOf="@+id/icLove" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/smart_engineer_logo"
            android:src="@drawable/sl_double_alt_arrow_right__black" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>