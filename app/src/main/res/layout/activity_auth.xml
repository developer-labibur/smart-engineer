<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sl_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center">

        <LinearLayout
            android:id="@+id/authHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                style="@style/sideBarLogo"
                android:layout_gravity="center"
                android:contentDescription="@string/smart_engineer_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                style="@style/tv_center_heading"
                android:gravity="center"
                android:fontFamily="@font/roboto"
                android:textSize="25sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_marginTop="-10dp"
                android:text="@string/app_slogan"
                android:textSize="14sp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:textStyle="bold"
                style="@style/tv_center_paragraph" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_gravity="center">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:id="@+id/btnContinueWithGoogle"
                android:layout_marginTop="30dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="50dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:padding="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:gravity="center"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/continue_with_social_media"
                        android:src="@drawable/sl_google_color"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/continue_with_google"
                        android:textColor="@color/mainContainer_HeadingText"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto"
                        android:layout_marginStart="10dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp">

                <view
                    android:id="@+id/viewLine"
                    class="android.widget.ImageView"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D7D7D7"
                    android:padding="2dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/orWith"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@color/sl_secondary"
                    android:fontFamily="@font/roboto"
                    android:paddingLeft="50dp"
                    android:paddingRight="50dp"
                    android:text="@string/or"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="@+id/viewLine"
                    app:layout_constraintEnd_toEndOf="@+id/viewLine"
                    app:layout_constraintStart_toStartOf="@+id/viewLine"
                    app:layout_constraintTop_toTopOf="@+id/viewLine" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:id="@+id/btnSignup"
                android:layout_marginTop="20dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/blue__DeepSkyBlue"
                app:cardCornerRadius="50dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:padding="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:gravity="center"
                    tools:ignore="UseCompoundDrawables">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/continue_with_email"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">

                <TextView
                    android:id="@+id/tvAnyAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/logo_font"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:text="@string/already_have_an_account"
                    android:textAlignment="center"
                    android:textColor="@color/mainContainer_SubHeadingText"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="-15dp"
                    android:background="@color/transparent"
                    android:fontFamily="@font/main_font_regular_2"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:text="@string/login_now"
                    android:textAllCaps="false"
                    android:textColor="@color/mainContainer_HeadingText"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvAnyAccount" />

                <view
                    android:id="@+id/view"
                    class="android.widget.ImageView"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/underlineText"
                    android:padding="2dp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnLogin"
                    app:layout_constraintEnd_toEndOf="@+id/btnLogin"
                    app:layout_constraintStart_toStartOf="@+id/btnLogin"
                    app:layout_constraintTop_toTopOf="@+id/btnLogin" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_terms_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="13dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/hind_siliguri"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/mainContainer_SubHeadingText"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </LinearLayout>

</ScrollView>