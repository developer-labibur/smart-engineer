<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainContainer_Bg"
    tools:context=".view.DashboardActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostDashboardFragmentContainerView"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        android:layout_above="@id/bottomLayout"
        app:navGraph="@navigation/dashboard_nav_graph" />

    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/sl_bottom_nav_bg"
        android:baselineAligned="false"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingEnd="15dp"
        android:paddingBottom="10dp"
        android:weightSum="4">

        <!-- Home Bottom -->
        <LinearLayout
            android:id="@+id/llHome"
            style="@style/bottom_nav_bg"
            tools:ignore="UseCompoundDrawables"
            android:background="@drawable/round_back_home_100">

            <ImageView
                android:id="@+id/ivHome"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/sl_icon"
                android:src="@drawable/sl_home_smile_angle_fill" />

            <TextView
                android:id="@+id/tvHome"
                android:visibility="visible"
                android:text="@string/home"
                android:textColor="@color/orange_text_color"
                style="@style/bottom_nav_text_style"/>

        </LinearLayout>

        <!-- Books Bottom -->
        <LinearLayout
            android:id="@+id/llBook"
            style="@style/bottom_nav_bg"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/ivBook"
                android:layout_width="20dp"
                android:contentDescription="@string/sl_icon"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/sl_notebook" />

            <TextView
                android:id="@+id/tvBook"
                android:text="@string/books"
                android:textColor="@color/blue_text_color"
                style="@style/bottom_nav_text_style" />

        </LinearLayout>

        <!-- Notice Bottom -->
        <LinearLayout
            android:id="@+id/llNotice"
            style="@style/bottom_nav_bg"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/ivNotice"
                android:layout_width="22dp"
                android:contentDescription="@string/sl_icon"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/sl_academic_cap" />

            <TextView
                android:id="@+id/tvNotice"
                android:text="@string/notice"
                android:textColor="@color/green_text_color"
                style="@style/bottom_nav_text_style"/>

        </LinearLayout>

        <!-- Explore Bottom -->
        <LinearLayout
            android:id="@+id/llExplore"
            style="@style/bottom_nav_bg"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/ivExplore"
                android:layout_width="20dp"
                android:contentDescription="@string/sl_icon"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/sl_library" />

            <TextView
                android:id="@+id/tvExplore"
                android:text="@string/explore"
                android:textColor="@color/purple_text_color"
                style="@style/bottom_nav_text_style"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>