<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="65dp"
    android:gravity="center"
    android:id="@+id/btnSemester"
    android:orientation="vertical"
    android:background="@color/sl_secondary"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/tv1stLetter">

    <View
        android:id="@+id/semView"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/blue_light_color"
        app:layout_constraintEnd_toStartOf="@+id/semLayout"
        app:layout_constraintHorizontal_bias="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/semAbbr"
        style="@style/btn_features_text"
        android:background="@color/sl_secondary"
        android:textSize="@dimen/text_size_large"
        app:layout_constraintBottom_toBottomOf="@id/semView"
        app:layout_constraintStart_toStartOf="@id/semView"
        app:layout_constraintEnd_toEndOf="@id/semView"
        app:layout_constraintTop_toTopOf="@+id/semView" />

    <ImageView
        android:id="@+id/semIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="@string/sl_icon"
        android:src="@drawable/sl_sort_right"
        app:layout_constraintBottom_toBottomOf="@+id/semView"
        app:layout_constraintEnd_toStartOf="@+id/semLayout"
        app:layout_constraintTop_toTopOf="@+id/semView"
        app:layout_constraintVertical_bias="0.52" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/semLayout"
        android:layout_width="0dp"
        android:layout_height="59dp"
        android:layout_marginStart="60dp"
        android:background="@drawable/abc_blue_light"
        app:layout_constraintBottom_toBottomOf="@+id/semView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_margin="5dp"
            android:id="@+id/semImage"
            style="@style/btn_features_image"
            android:background="@drawable/abc_orange_main"
            android:contentDescription="@string/sl_icon"
            android:src="@drawable/number_one"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/semNumber"
            style="@style/btn_features_text"
            android:layout_marginStart="8dp"
            android:layout_marginTop="5dp"
            android:textSize="@dimen/text_size_large"
            app:layout_constraintStart_toEndOf="@+id/semImage"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDep"
            style="@style/sem_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/semImage"
            app:layout_constraintTop_toBottomOf="@id/semNumber" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
