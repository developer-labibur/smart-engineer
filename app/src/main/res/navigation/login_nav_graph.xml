<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_nav_graph"
    app:startDestination="@id/loginFragment">
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.rudhashi.smartengineer.fragment.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardActivity"
            app:destination="@id/smartDashboardActivity"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@anim/animation1" />
    </fragment>
    <fragment
        android:id="@+id/signupFragment"
        android:name="com.rudhashi.smartengineer.fragment.SignupFragment"
        android:label="fragment_signup"
        tools:layout="@layout/fragment_signup" >
        <action
            android:id="@+id/action_signupFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_signupFragment_to_smartDashboardActivity"
            app:destination="@id/smartDashboardActivity" />
    </fragment>
    <activity
        android:id="@+id/smartDashboardActivity"
        android:name="com.rudhashi.smartengineer.dashboard.SmartDashboardActivity"
        android:label="activity_smart_dashboard"
        tools:layout="@layout/activity_smart_dashboard" />
</navigation>