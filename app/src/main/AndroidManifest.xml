<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">



    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />



    <application
        android:name=".MyAdmobApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartEngineer"
        tools:targetApi="31">

        <activity
            android:name=".view.SplashScreenActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activities.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".page.AboutUsActivity"
            android:exported="false" />
        <activity
            android:name=".view.SmartPointActivity"
            android:exported="false" />
        <activity
            android:name=".view.DayNightActivity"
            android:exported="false" />
        <activity
            android:name=".view.MainActivity"
            android:exported="false" />
        <activity
            android:name=".view.SmartViewActivity"
            android:exported="false" />
        <activity
            android:name=".view.SmartEBookActivity"
            android:exported="false" />
        <activity
            android:name=".TestActivity"
            android:exported="false" />
        <activity
            android:name=".view.DepartmentActivity"
            android:exported="false" />
        <activity
            android:name=".view.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".view.DashboardActivity"
            android:exported="false" />
        <activity
            android:name=".dashboard.SmartDashboardActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".view.AllBookActivity"
            android:exported="false" />
        <activity
            android:name=".view.BookDetailsActivity"
            android:exported="false" />






        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" /> <!-- Resolve conflict by prioritizing gma_ad_services_config -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" /> <!-- Test ~ AdMob App ID => ca-app-pub-3940256099942544~3347511713 -->
        <!-- Real ~ AdMob App ID => ca-app-pub-6550723267014585~7554804426 -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>

</manifest>